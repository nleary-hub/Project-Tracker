# Copy to .env.local for local development. Never commit real values.

# Supabase (Project settings → API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Added in later milestones:
# SUPABASE_SECRET_KEY=          (M6: report builder reads admin-only tables)
# CRON_SECRET=                  (M8: protects /api/cron/daily)
# GMAIL_USER= / GMAIL_APP_PASSWORD=   (M8: email transport)
